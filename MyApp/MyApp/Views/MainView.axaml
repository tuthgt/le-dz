<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyApp.Views.MainView">

    <TabControl>

        <!-- Вкладка 1: Команды -->
        <TabItem Header="Команды">
            <ListBox x:Name="TeamsList"/>
        </TabItem>

        <!-- Вкладка 2: Квесты -->
        <TabItem Header="Квесты">
            <ListBox x:Name="QuestsList"/>
        </TabItem>

        <!-- Вкладка 3: Прохождения -->
        <TabItem Header="Прохождения">
            <ListBox x:Name="PlaythroughsList"/>
        </TabItem>

    </TabControl>

</UserControl>