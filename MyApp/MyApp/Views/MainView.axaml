<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MyApp.Data.Models"
             x:Class="MyApp.Views.MainView">

    <TabControl>

        <!-- КОМАНДЫ -->
        <TabItem Header="Команды">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12"
                            Spacing="8"
                            MaxWidth="300"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Добавление команды"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Название команды" TextWrapping="Wrap" />
                    <TextBox x:Name="TeamNameBox" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Имя капитана" TextWrapping="Wrap" />
                    <TextBox x:Name="CaptainNameBox" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Количество участников" TextWrapping="Wrap" />
                    <TextBox x:Name="MemberCountBox" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Уровень опыта" TextWrapping="Wrap" />
                    <TextBox x:Name="ExperienceLevelBox" MinHeight="44" MaxWidth="300" />

                    <Button x:Name="AddTeamButton" Content="Добавить" MinHeight="44" MaxWidth="300" />
                    <Button x:Name="DeleteTeamButton" Content="Удалить выбранную" MinHeight="44" MaxWidth="300" />
                    <Button x:Name="SaveTeamButton" Content="Сохранить изменения" MinHeight="44" MaxWidth="300" />

                    <TextBlock x:Name="TeamMessage" TextWrapping="Wrap" />

                    <TextBlock Text="Список команд"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                    <ListBox x:Name="TeamsList" MaxHeight="220" />

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- КВЕСТЫ -->
        <TabItem Header="Квесты">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12"
                            Spacing="8"
                            MaxWidth="300"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Добавление квеста"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Название квеста" TextWrapping="Wrap" />
                    <TextBox x:Name="QuestTitleBox" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Жанр" TextWrapping="Wrap" />
                    <TextBox x:Name="QuestGenreBox" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Сложность (1-5)" TextWrapping="Wrap" />
                    <TextBox x:Name="QuestDifficultyBox" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Уровень страха (1-5)" TextWrapping="Wrap" />
                    <TextBox x:Name="QuestFearLevelBox" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Продолжительность (минуты)" TextWrapping="Wrap" />
                    <TextBox x:Name="QuestDurationBox" MinHeight="44" MaxWidth="300" />

                    <Button x:Name="AddQuestButton" Content="Добавить" MinHeight="44" MaxWidth="300" />
                    <Button x:Name="DeleteQuestButton" Content="Удалить выбранный" MinHeight="44" MaxWidth="300" />

                    <TextBlock x:Name="QuestMessage" TextWrapping="Wrap" />

                    <TextBlock Text="Список квестов"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                    <ListBox x:Name="QuestsList" MaxHeight="220" />

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ПРОХОЖДЕНИЯ -->
        <TabItem Header="Прохождения">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12"
                            Spacing="8"
                            MaxWidth="300"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Добавление прохождения"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Команда" TextWrapping="Wrap" />
                    <ComboBox x:Name="PlaythroughTeamComboBox" MinHeight="44" MaxWidth="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Team">
                                <TextBlock Text="{Binding TeamName}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Квест" TextWrapping="Wrap" />
                    <ComboBox x:Name="PlaythroughQuestComboBox" MinHeight="44" MaxWidth="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Quest">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Дата начала" TextWrapping="Wrap" />
                    <CalendarDatePicker x:Name="PlaythroughDatePicker" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Время начала" TextWrapping="Wrap" />
                    <TimePicker x:Name="PlaythroughTimePicker" MinHeight="44" MaxWidth="300" />

                    <TextBlock Text="Оплаченная сумма (руб.)" TextWrapping="Wrap" />
                    <TextBox x:Name="PaidAmountBox" MinHeight="44" MaxWidth="300" />

                    <CheckBox x:Name="IsCompletedCheckBox"
                              Content="Квест завершён"
                              MinHeight="44"
                              MaxWidth="300" />

                    <Button x:Name="AddPlaythroughButton" Content="Добавить" MinHeight="44" MaxWidth="300" />
                    <Button x:Name="DeletePlaythroughButton" Content="Удалить выбранное" MinHeight="44" MaxWidth="300" />

                    <TextBlock x:Name="PlaythroughMessage" TextWrapping="Wrap" />

                    <TextBlock Text="Список прохождений"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                    <ListBox x:Name="PlaythroughsList" MaxHeight="220" />

                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>

</UserControl>
